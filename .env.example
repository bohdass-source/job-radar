# Output language of reports, dialogs and the digest: en | ru
JOB_RADAR_LANG=en

# MongoDB (docker compose starts it on this address)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=job_radar

# Your llm-gateway. The client speaks the OpenAI-compatible
# POST {LLM_GATEWAY_URL}/v1/chat/completions contract; adapt
# src/job_radar/extract/llm.py if your gateway differs.
LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=default

# Source keys (only for sources you have approved in config/sources.yaml)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Your own mailbox for LinkedIn / Indeed job-alert emails (read-only IMAP).
# Use an app password. job-radar never opens the links inside the emails.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Weekly digest (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# Local receiver for the "send this page to job-radar" bookmarklet.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
INBOX_TOKEN=
INBOX_PORT=8765
